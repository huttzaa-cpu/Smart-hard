<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toyota Yaris/Ativ Smart Gauge 2.8" (OBD2 Bluetooth)</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; user-select: none; }
        body { background: #000; display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 100vh; color: #fff; }

        /* แถบควบคุมบนหน้าจอคอม/มือถือ */
        .control-bar {
            margin-bottom: 12px;
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .btn-ctrl {
            background: #1e293b;
            color: #38bdf8;
            border: 1px solid #0284c7;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-ctrl:hover { background: #0284c7; color: #fff; }
        .bt-status { font-size: 14px; color: #ef4444; font-weight: bold; }
        .bt-status.connected { color: #22c55e; }

        /* กรอบจำลองจอ 2.8" สัดส่วน 4:3 (640x480) */
        .gauge-screen {
            width: 640px;
            height: 480px;
            background: #050505;
            border: 10px solid #1c1c1c;
            border-radius: 16px;
            box-shadow: 0 0 35px rgba(0, 229, 255, 0.15);
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 12px;
            overflow: hidden;
        }

        /* Grid Layout 3 คอลัมน์ x 2 แถว */
        .grid-main {
            display: grid;
            grid-template-columns: 1.1fr 1.3fr 1.1fr;
            grid-template-rows: 1fr 1fr;
            gap: 8px;
            height: 385px;
        }

        .box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Label & Units */
        .label-title { font-size: 16px; color: #00E5FF; font-weight: bold; letter-spacing: 0.5px; }
        .label-sub { font-size: 12px; color: #888; text-transform: uppercase; }
        .val-large { font-size: 42px; font-weight: bold; color: #fff; line-height: 1; }
        .unit-text { font-size: 14px; color: #aaa; font-weight: normal; }

        /* แถบ Progress Bar Graph */
        .bar-container { background: #1a1a1a; height: 14px; border-radius: 4px; overflow: hidden; margin-top: 6px; position: relative; }
        .bar-fill { height: 100%; background: linear-gradient(90deg, #00FF66, #FFCC00); width: 0%; transition: width 0.3s ease; }

        /* 1. มุมซ้ายบน - ความร้อนน้ำ */
        .box-coolant { grid-column: 1; grid-row: 1; }

        /* 2. มุมขวาบน - น้ำมันเกียร์ */
        .box-trans { grid-column: 3; grid-row: 1; text-align: right; }
        .box-trans .bar-fill { background: linear-gradient(90deg, #00FF66, #FF9900); float: right; }

        /* 3. ตรงกลาง - วัดรอบ + ความเร็ว */
        .box-center {
            grid-column: 2;
            grid-row: 1 / span 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        
        /* วงโค้งวัดรอบ RPM Arc */
        .rpm-arc-bg {
            width: 200px;
            height: 100px;
            border: 10px solid #222;
            border-top: 10px solid #00E5FF;
            border-right: 10px solid #FFCC00;
            border-left: 10px solid #00FF66;
            border-radius: 100px 100px 0 0;
            position: relative;
            margin-bottom: -15px;
        }

        .speed-val { font-size: 54px; font-weight: bold; text-align: center; margin-top: 2px; color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .rpm-val { font-size: 44px; font-weight: bold; color: #00FF66; text-shadow: 0 0 10px rgba(0,255,102,0.3); }

        /* 4. มุมซ้ายล่าง - ไฟแบตเตอรี่ */
        .box-battery { grid-column: 1; grid-row: 2; }
        
        /* 5. มุมขวาล่าง - อัตราส่วน AFR */
        .box-afr { grid-column: 3; grid-row: 2; text-align: right; }
        .afr-status { font-size: 14px; color: #00FF66; font-weight: bold; }

        /* ไอคอนไฟเตือน Check Engine */
        .check-engine-icon {
            position: absolute;
            bottom: 12px;
            width: 34px;
            height: 26px;
            background: #444;
            transition: background 0.3s;
            mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 4v2h3v2H3v8h2v3h4v-3h6v3h4v-3h2V8h-7V6h3V4H7z"/></svg>') no-repeat center;
            -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 4v2h3v2H3v8h2v3h4v-3h6v3h4v-3h2V8h-7V6h3V4H7z"/></svg>') no-repeat center;
        }
        .check-engine-icon.active { background: #FF3300; animation: blink 1s infinite; }

        @keyframes blink { 50% { opacity: 0.3; } }

        /* แถบเมนูด้านล่าง (Bottom Navbar) */
        .nav-bar {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            background: #111;
            padding: 4px;
            border-radius: 6px;
            border: 1px solid #222;
        }
        .nav-btn {
            background: #1a1a1a;
            color: #aaa;
            border: 1px solid #333;
            padding: 8px 0;
            text-align: center;
            font-size: 14px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .nav-btn.active { background: #fff; color: #000; font-weight: bold; border-color: #fff; }

        /* Modal หน้าต่างสแกน OBD / ตั้งค่า */
        .modal {
            display: none;
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.92);
            z-index: 100;
            padding: 20px;
            flex-direction: column;
            justify-content: space-between;
        }
        .modal.open { display: flex; }
        .modal-title { font-size: 20px; color: #00E5FF; border-bottom: 1px solid #333; padding-bottom: 8px; }
        .modal-body { font-size: 16px; margin-top: 15px; color: #ccc; line-height: 1.6; }
        .modal-btn { background: #00E5FF; color: #000; border: none; padding: 10px; font-weight: bold; border-radius: 4px; cursor: pointer; text-align: center; }
    </style>
</head>
<body>

    <!-- แถบปุ่มควบคุมภายนอกสำหรับเชื่อมต่อ Bluetooth หรือทดสอบ Demo -->
    <div class="control-bar">
        <button class="btn-ctrl" onclick="connectBluetooth()">🔌 เชื่อมต่อ ELM327 Bluetooth</button>
